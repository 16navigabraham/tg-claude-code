# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
ALLOWED_TELEGRAM_USER_ID=your_numeric_telegram_user_id


# ── Fallback provider (optional) ─────────────────────────────────────────────
# A second Anthropic API key, used automatically when your Claude Code
# subscription / OAuth is rate-limited. Get one from https://console.anthropic.com.
# Runs in a fully separate per-session state dir so the two transcripts never mix.
# Leave the key blank to disable the fallback (the bot then just reports the
# rate limit and DMs you when it resets).
FALLBACK_ANTHROPIC_API_KEY=            # sk-ant-...
FALLBACK_ANTHROPIC_MODEL=claude-sonnet-4-5
# Only set this if you're routing through an Anthropic-API-compatible proxy
# instead of the real API. Defaults to https://api.anthropic.com.
FALLBACK_ANTHROPIC_BASE_URL=

# FORCE_FALLBACK=1 skips the subscription and always uses the fallback
# (for testing that path). Leave unset in normal operation.
FORCE_FALLBACK=

# Paths - adjust to wherever you deploy. $HOME-relative is fine.
SESSIONS_ROOT=./sessions
DB_PATH=./data/bot.db

# A run is killed if it emits no output for CLAUDE_STALL_TIMEOUT_MS (hung), or
# if total runtime exceeds CLAUDE_MAX_RUNTIME_MS (absolute backstop). An
# actively working task is left alone up to the backstop. Both optional -
# defaults are 5 min / 45 min. (The old CLAUDE_TIMEOUT_MS is no longer used;
# delete it from your .env if present.)
CLAUDE_STALL_TIMEOUT_MS=300000
CLAUDE_MAX_RUNTIME_MS=2700000

# Default subscription model for every session (per-session /model overrides it).
# Blank = your plan's default. Set to "sonnet" to make Sonnet the default and
# stretch your usage limit.
CLAUDE_MODEL=

# Max agentic tool-loop steps per message. Unsupervised, one instruction can
# otherwise run 20-40 steps, each re-billing the whole context - the biggest
# usage difference vs a human-steered PC session. On hit, the reply ends with
# "reply continue" and you decide. Default 30. Set 0 to disable the cap.
# If runs fail with "unknown option '--max-turns'", set this to 0.
CLAUDE_MAX_TURNS=30

# Permission mode for the spawned `claude` process. On a headless VPS with no
# TTY to approve prompts, bypassPermissions is what actually works (anything
# stricter denies/hangs every git/npm/test command). The deny-list below is
# still enforced regardless of mode.
CLAUDE_PERMISSION_MODE=bypassPermissions

# Absolute deny rules, enforced even under bypassPermissions - blocks reading
# secret files, destructive git/fs, and edits to the bot's own repo. Newline or
# comma separated; setting it REPLACES the built-in defaults. Leave blank to use
# the defaults. (Not a hard security boundary - a bypass agent can still read a
# file via python/xxd - it's accident + casual-misuse protection.)
CLAUDE_DENY=

# APPROVAL_GATE=1 makes the bot ask you (inline Approve/Deny buttons on Telegram)
# before each tool call that isn't already allow/deny-ruled - like the prompts
# on your PC terminal. Switches the run to permission-mode "default". Unanswered
# requests auto-deny after 15 min. If the bot can't be reached, it falls back to
# APPROVAL_FALLBACK (default "allow"; set "deny" to fail closed).
APPROVAL_GATE=
APPROVAL_FALLBACK=allow
# By default the prompt is DELETED once you answer (terminal-style, no clutter).
# Set APPROVAL_KEEP_LOG=1 to leave a "Approved - ..." line behind instead.
APPROVAL_KEEP_LOG=

# Timezone for Claude's own timestamped messages (rate-limit resets, etc.) and
# any `date`/`ls -la` output inside sessions. IANA name, e.g. Africa/Lagos.
# Blank = UTC (the VPS default).
TZ=Africa/Lagos

# Your claude.ai MCP connectors load by default. Set to 1 to drop them from bot
# runs (faster, ~15-20k fewer tokens per prompt, but no Gmail/Drive/etc.).
CLAUDE_STRICT_MCP=

# PERSISTENT_CLAUDE=1 keeps ONE long-lived `claude` process per session (like a
# PC terminal) instead of spawning one per message - restores prompt caching
# across turns, so the usage limit lasts much longer. Subscription path only.
# The process is killed after PERSISTENT_IDLE_MS of no use and respawned
# (--resume) on the next message. Leave blank to use the proven per-message path.
PERSISTENT_CLAUDE=
PERSISTENT_IDLE_MS=900000

# /preview: local port for the static server, and how long to wait for a page
# (or a dev server) to come up. Optional - defaults 4173 / 30000.
PREVIEW_PORT=4173
PREVIEW_WAIT_MS=30000

# /tunnel: public *.trycloudflare.com URL for a session's site (needs cloudflared
# on the VPS - scripts/tunnel-setup.sh). All optional.
#   TUNNEL_IDLE_MS  close after this long with no /tunnel command (default 2h)
#   TUNNEL_MAX_MS   hard lifetime cap (default 8h)
#   TUNNEL_WAIT_MS  how long to wait for the dev server / cloudflared URL (40s)
#   CLOUDFLARED_BIN path to the binary if not on PATH
TUNNEL_IDLE_MS=7200000
TUNNEL_MAX_MS=28800000
TUNNEL_WAIT_MS=40000

# Where scripts/daemon.sh keeps pidfiles/logs for the servers & tunnels Claude
# starts itself (multi-project sessions). Optional - default data/daemons.
# DAEMON_DIR=/home/ubuntu/tg-claude-agent/data/daemons

# When a session's context reaches this many tokens, replies append a nudge to
# /new a fresh session. Optional - default 160000.
CONTEXT_WARN_TOKENS=160000

# Every task reply/progress line is prefixed with [session-name] for tracing.
# Set to 0 to turn that off.
SESSION_TAG=1

# Claude subscription token from `claude setup-token` (~1 year). Normally set
# via the bot's /reauth command, which writes ./data/oauth-token; this env var
# is just a fallback. Takes precedence over ~/.claude/.credentials.json.
CLAUDE_CODE_OAUTH_TOKEN=
# OAUTH_TOKEN_FILE=data/oauth-token   # override where /reauth stores it

# Voice notes: paths to the whisper.cpp binary + model on the VPS, and thread
# count. Optional - defaults assume ~/tools/whisper.cpp with ggml-base.en.bin.
# Needs ffmpeg installed (sudo apt install -y ffmpeg).
WHISPER_BIN=/home/ubuntu/tools/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/home/ubuntu/tools/whisper.cpp/models/ggml-base.en.bin
WHISPER_THREADS=4
